SERVER_URL=http://localhost:8080
EVO_BASE_URL=http://localhost:8080
EVO_INSTANCE_NAME=affiliate
AUTHENTICATION_API_KEY=change-me
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
EVO_TIMEOUT=30
EVO_REQUEST_ORIGIN=http://localhost:8080
CONFIG_SESSION_PHONE_CLIENT=RSSTUDIOUS Afiliados
CONFIG_SESSION_PHONE_NAME=Chrome
EVO_TEST_PHONE=5571999999999
EVO_TEST_MEDIA_PHONE=5571999999999

WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_URL=http://host.docker.internal:8000/webhooks/evolution
WEBHOOK_EVENTS=MESSAGES_UPSERT
WEBHOOK_SECRET=
WEBHOOK_SECRET_HEADER=X-Webhook-Secret
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true

AFFILIATE_ENABLED=false
AFFILIATE_SOURCE_GROUP_JIDS=
AFFILIATE_DESTINATION_GROUP_JID=
AFFILIATE_DB_PATH=data/affiliate.sqlite3
AFFILIATE_ALLOWED_DOMAINS=meli.la,mercadolivre.com.br,www.mercadolivre.com.br,s.shopee.com.br,shopee.com.br,www.shopee.com.br
AFFILIATE_MERCADO_LIVRE_ENABLED=true
AFFILIATE_SHOPEE_ENABLED=false
AFFILIATE_AUTO_PUBLISH=false
AFFILIATE_REVIEW_REQUIRED=true
AFFILIATE_DEDUPE_DAYS=7
AFFILIATE_MAX_RETRIES=3
AFFILIATE_TIMEZONE=America/Bahia
AFFILIATE_MIN_SEND_INTERVAL_SECONDS=90
AFFILIATE_DAILY_LIMIT=40
AFFILIATE_REVIEW_BATCH_LIMIT=20
AFFILIATE_MERCADO_LIVRE_MARKER=
AFFILIATE_SHOPEE_MARKER=
AFFILIATE_MERCADO_LIVRE_PLAYWRIGHT_ENABLED=false
AFFILIATE_PLAYWRIGHT_HEADLESS=true
AFFILIATE_PLAYWRIGHT_CONVERSION_LIMIT=1
AFFILIATE_PLAYWRIGHT_BROWSER=edge

EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_API_BIND=127.0.0.1
EVOLUTION_API_PORT=8080

POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_DB=evolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production
REDIS_DATABASE=6

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
