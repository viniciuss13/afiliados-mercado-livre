EVO_TIMEOUT=30
EVO_REQUEST_ORIGIN=http://localhost:8080
EVO_PHONE_LOGGER=5571999999999
EVO_ADMIN_PHONES=5571999999999,5571888888888
EVO_TEST_PHONE=5571999999999
EVO_TEST_MEDIA_PHONE=5571999999999

WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_URL=http://host.docker.internal:8000/webhooks/evolution
GOOGLE_FORM_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/google-form/mantenedor
WEBHOOK_EVENTS=MESSAGES_UPSERT
WEBHOOK_SECRET=
WEBHOOK_SECRET_HEADER=X-Webhook-Secret

WECARE_WELCOME_IMAGE_URL=
WECARE_WELCOME_IMAGE_PATH=automation_whats/img/we_care.jpeg
WECARE_WELCOME_IMAGE_MIME=image/jpeg
WECARE_WELCOME_IMAGE_NAME=we_care.jpeg

GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_SECRET_FILE=credentials/google-oauth-client-secret.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/google-oauth-token.json
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=1IRVyir9AxtKlGCOHOo6JfZp1vQZ73_UmZOENz3_zJ7U
GOOGLE_SPREADSHEET_NAME=Mantenedores We Care
GOOGLE_WORKSHEET_NAME=mantenedores
GOOGLE_FORMER_WORKSHEET_NAME=antigos_mantenedores
GOOGLE_SHEETS_RANGE=A:Z

EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_API_BIND=127.0.0.1
EVOLUTION_API_PORT=8080

POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_DB=evolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production
REDIS_DATABASE=6

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
